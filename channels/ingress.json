{
  "routes": [
    {
      "path": "events-photon",
      "kind": "http",
      "description": "Inbound message webhooks from a Photon (Spectrum) project (messages).",
      "verification": {
        "kind": "hmac",
        "algorithm": "sha256",
        "secret": {
          "field": "photon_webhook_secret"
        },
        "signature": {
          "header": "X-Spectrum-Signature",
          "encoding": "hex",
          "prefix": "v0="
        },
        "payload": [
          {
            "literal": "v0:"
          },
          {
            "header": "X-Spectrum-Timestamp"
          },
          {
            "literal": ":"
          },
          "body"
        ],
        "freshness": {
          "header": "X-Spectrum-Timestamp",
          "format": "unix-seconds",
          "toleranceSeconds": 300
        }
      }
    },
    {
      "path": "events-comms",
      "kind": "http",
      "description": "Inbound message webhooks from a Comms by Osis line (comms.message.received).",
      "verification": {
        "kind": "hmac",
        "algorithm": "sha256",
        "secret": {
          "field": "comms_webhook_secret"
        },
        "signature": {
          "header": "X-Osis-Signature",
          "encoding": "hex",
          "prefix": "sha256="
        },
        "payload": [
          "body"
        ]
      }
    }
  ]
}
